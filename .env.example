# FALD environment variables
# Copy this file to `.env` (or export the variables in your shell) and fill in your own keys.
# `.env` is git-ignored - never commit real keys.
#
# Quick start:
#   Linux/macOS:  export LLM_API_KEY="your-key-here"
#   PowerShell:   $env:LLM_API_KEY="your-key-here"
#   (or) copy this file to .env and use a loader like python-dotenv

# Required: your LLM provider API key.
# FALD reads this via os.environ.get('LLM_API_KEY') in FALD_Implement.py / LLM_Detection_Algorithm.py.
# Default provider: Alibaba Bailian (DashScope) for Qwen3-Next-80B-A3B-Instruct.
# Also works with DeepSeek or any OpenAI-compatible endpoint - just change model_name/API_Url in the script.
LLM_API_KEY=
